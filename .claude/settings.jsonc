// Commented copy of .claude/settings.json. Claude Code reads settings.json, which is plain JSON and cannot
// hold comments, so the explanation lives here. `npm test` fails if the two files drift apart: change both in
// the same commit (strip the comments and you get settings.json).
//
// How Claude Code resolves a tool call: a `deny` rule wins over everything, then `ask`, then `allow`; anything
// not listed falls back to `defaultMode`. The PreToolUse hook runs on top of all of that and can block a call
// that the permissions allow. Rules are prefix matches on the command text, so they are a convenience and a
// first layer, never the only one.
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    // File edits inside the project are accepted without asking. Commands still follow the lists below.
    "defaultMode": "acceptEdits",

    // ALLOW: what Claude may run without asking: git commands that read or that write inside the repository
    // and are undone with git, and the test suite. Be honest about the last one: `npm test` runs code from
    // the repository, and Claude can write that code. It stays here because the step-by-step loop needs it;
    // the hook does not inspect what it runs. Arbitrary `npm run <script>` is in ask.
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      // On Windows Claude Code may also use PowerShell: every rule needs its PowerShell twin, or the
      // command silently falls back to defaultMode.
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)"
    ],

    // ASK: what Claude may run only after a human says yes, every time. Anything that leaves the machine
    // (push, network), rewrites history, deletes files or installs code that may run scripts.
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(npx *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)",
      "PowerShell(git clean *)",
      // PowerShell twins, plus its aliases: ri, rd and erase delete; iwr and irm download.
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(ri *)",
      "PowerShell(rd *)",
      "PowerShell(del *)",
      "PowerShell(erase *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(iwr *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(irm *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(npx *)",
      "PowerShell(npm install *)",
      "PowerShell(npm run *)"
    ],

    // DENY: never, not even if a human approves in the moment (edit this file by hand instead).
    // Secrets: list the usual .env variants one by one. A generic "./.env.*" would also deny .env.example,
    // the versioned template with names only; the hook covers every other .env.* file.
    // Guardrails: Claude must not be able to edit the rules that bind it, widen its own tools (commands and
    // agents declare tools) or redirect git (.git/config, .git/hooks). The hook blocks it too, also from the
    // shell, where these Edit rules do not reach.
    // Protected data: one Read and one Edit rule per entry of PROTECTED in the hook.
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.jsonc)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/commands/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./.git/**)",
      "Read(./data/private/**)",
      "Edit(./data/private/**)"
    ]
  },

  // The guard hook runs before every tool that can read, write or execute. Exit code 2 blocks the call.
  // $CLAUDE_PROJECT_DIR keeps it working whatever the current directory is.
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
